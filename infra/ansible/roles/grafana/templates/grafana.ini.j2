; {{ pve_managed_note | default('Managed by Ansible') }}
[server]
http_addr = {{ grafana_bind }}
http_port = {{ grafana_port }}

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
; Prevents the embedded-in-an-iframe class of attack; harmless here, and the
; right default once this sits behind Traefik.
cookie_secure = false
disable_gravatar = true

[users]
; Single-operator homelab: nobody should be signing themselves up.
allow_sign_up = false

[analytics]
reporting_enabled = false
check_for_updates = false
