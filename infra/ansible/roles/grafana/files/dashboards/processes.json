{
  "uid": "processes",
  "title": "Processes",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Host services",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "$node CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{instance=\"$node\", groupname=~\"cluster|api|pve services|monitoring\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{groupname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 25,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": null,
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "100% is one core. Guests are below.",
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "$node memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (groupname) (namedprocess_namegroup_memory_bytes{instance=\"$node\", memtype=\"resident\", groupname=~\"cluster|api|pve services|monitoring\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{groupname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 25,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": null,
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Guests",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "$node guest CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{instance=\"$node\", groupname=~\"lxc/.*|qemu/.*\"}[$__rate_interval])), \"id\", \"$1\", \"groupname\", \"(.*)\") * on (id) group_left (name) max by (id, name) (pve_guest_info)",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 25,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": null,
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Everything running inside each container. 100% is one core.",
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "$node guest memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (groupname) (namedprocess_namegroup_memory_bytes{instance=\"$node\", memtype=\"resident\", groupname=~\"lxc/.*|qemu/.*\"}), \"id\", \"$1\", \"groupname\", \"(.*)\") * on (id) group_left (name) max by (id, name) (pve_guest_info)",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 25,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "sortBy": null,
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(namedprocess_namegroup_num_procs, instance)",
          "refId": "V"
        },
        "definition": "label_values(namedprocess_namegroup_num_procs, instance)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "description": "Per node: the Proxmox services, the monitoring agents, and each guest as one group."
}
