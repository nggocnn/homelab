# Managed by Ansible (homelab/infra/ansible) - do not edit by hand
# The guests the certificate reaches. No nodes, no edge containers.
{% for host in (groups['lxc'] + groups['vm']) | reject('equalto', inventory_hostname) if hostvars[host].ssh_principal in ssh_certs.bastion.principals %}
Host {{ host }}
    HostName {{ hostvars[host].ansible_host }}
    User {{ hostvars[host].ansible_user }}

{% endfor %}
Host *
    IdentityFile {{ bastion_identity_file }}
    IdentitiesOnly yes
