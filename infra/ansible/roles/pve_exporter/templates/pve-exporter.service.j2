# {{ pve_managed_note | default('Managed by Ansible') }}
[Unit]
Description=Prometheus Proxmox VE Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pve-exporter
Group=pve-exporter
ExecStart={{ pve_exporter_venv }}/bin/pve_exporter \
  --config.file=/etc/prometheus/pve.yml \
  --web.listen-address=127.0.0.1:{{ pve_exporter_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
