# {{ pve_managed_note }}
# Proxmox resolves its own node name through this file, and corosync resolves
# its peers through it. A wrong or missing entry breaks the web UI and cluster
# communication, so it is templated here rather than appended to by hand.
127.0.0.1 localhost.localdomain localhost
{{ ansible_host }} {{ inventory_hostname }}.{{ pve_domain }} {{ inventory_hostname }}
{% for host in groups['pve'] | difference([inventory_hostname]) | sort %}
{{ hostvars[host].ansible_host }} {{ host }}.{{ pve_domain }} {{ host }}
{% endfor %}

# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
ff02::3 ip6-allhosts
