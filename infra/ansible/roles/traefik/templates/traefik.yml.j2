# {{ pve_managed_note | default('Managed by Ansible') }}
# Static configuration. Routes live in dynamic.yml so adding a service does not
# require restarting Traefik.
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

providers:
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

api:
  dashboard: true

log:
  level: INFO

# The internal CA is not a public one, so there is nothing to phone home about.
global:
  checkNewVersion: false
  sendAnonymousUsage: false
