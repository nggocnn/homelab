# Managed by Ansible. One binary on the filesystem: three nodes' journals, not a log cluster.
auth_enabled: false

server:
  http_listen_port: {{ loki_port }}
  grpc_listen_port: 9096
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "2026-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: {{ loki_retention }}
  reject_old_samples: true
  reject_old_samples_max_age: 168h

# Retention is the compactor's job, and it deletes nothing unless told to.
compactor:
  working_directory: {{ loki_data_dir }}/compactor
  retention_enabled: true
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
