# {{ pve_managed_note | default('Managed by Ansible') }}
services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    restart: unless-stopped
    ports:
      - "{{ homepage_port }}:3000"
    environment:
      # Homepage refuses requests whose Host header is not listed here.
      HOMEPAGE_ALLOWED_HOSTS: "{{ homepage_allowed_hosts }}"
    volumes:
      - {{ homepage_dir }}/config:/app/config
