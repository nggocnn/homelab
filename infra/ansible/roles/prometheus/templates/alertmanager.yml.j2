# {{ pve_managed_note | default('Managed by Ansible') }}
route:
  receiver: ntfy
  # Group by alert and node so one bad node does not produce one notification
  # per rule, but a genuinely new problem is not swallowed into an existing group.
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  # Deliberately long: these are homelab alerts, and a re-notify every few hours
  # is a reminder, not an incident page.
  repeat_interval: 12h

  routes:
    - matchers: ['severity="critical"']
      receiver: ntfy-critical
      repeat_interval: 2h

receivers:
  - name: ntfy
    webhook_configs:
      - url: "{{ ntfy_url }}/{{ ntfy_topic }}?template=alertmanager"
        send_resolved: true

  - name: ntfy-critical
    webhook_configs:
      - url: "{{ ntfy_url }}/{{ ntfy_topic }}?template=alertmanager&priority=high"
        send_resolved: true

inhibit_rules:
  # A node that is down will trip every other rule about it. Suppress the noise
  # and report the one thing that matters.
  - source_matchers: ['alertname="NodeDown"']
    target_matchers: ['severity=~"warning|critical"']
    equal: ["instance"]
